<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="StudyBuddyPU" transaction-type="JTA">
        <jta-data-source>jdbc/StudyBuddy</jta-data-source>
        <class>ch.unil.doplab.studybuddy.domain.Student</class>
        <class>ch.unil.doplab.studybuddy.domain.Topic</class>
        <class>ch.unil.doplab.studybuddy.domain.Affinity</class>
        <class>ch.unil.doplab.studybuddy.domain.Lesson</class>
        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
            <property name="eclipselink.logging.level" value="FINEST"/>
        </properties>
    </persistence-unit>
</persistence>